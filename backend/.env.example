# ---- Wazuh (existing) ----
WAZUH_HOST=your-wazuh-host
WAZUH_PORT=55000
WAZUH_USERNAME=
WAZUH_PASSWORD=
INDEXER_USERNAME=
INDEXER_PASSWORD=
PORT=3000

# ---- AI Analyst (OpenRouter) ----
# Required for AI answers. Leave empty and the rest of the dashboard still works.
OPENROUTER_API_KEY=
# Free model availability changes; pick any open-weight model listed on openrouter.ai/models (filter: free).
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Optional comma-separated models tried if the primary is unavailable or rate limited.
OPENROUTER_FALLBACK_MODELS=
# Optional
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=
OPENROUTER_SITE_TITLE=SOC Investigator
AI_ENABLED=true
AI_TIMEOUT_MS=60000
AI_MAX_TOKENS=1800
AI_TEMPERATURE=0.2
AI_MAX_EVIDENCE_ALERTS=40
AI_MAX_HISTORY_MESSAGES=12
AI_RATE_LIMIT_PER_MINUTE=10
AI_EVIDENCE_WINDOW_HOURS=24

# ---- Live investigation restriction ----
# Fixed in backend code: Wazuh agent 001 (win-11). No environment override is supported.
